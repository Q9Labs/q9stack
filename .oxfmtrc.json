{
  "$schema": "https://oxc.rs/schema/oxfmtrc.json",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/.output/**",
    ".worktrees/**",
    "scratchpad/**",
    "templates/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "**/routeTree.gen.ts",
    "registry/public/**",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "theory.md",
    "glossary.md"
  ]
}
