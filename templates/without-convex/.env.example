# Runtime environment: dev or prod.
APP_ENV=
# Public application origin, for example https://app.example.com.
APP_URL=
# Public API origin, for example http://localhost:3001.
API_URL=
# Browser-safe application origin used by the web bundle.
PUBLIC_APP_URL=
# Browser-safe API origin used by the web bundle.
PUBLIC_API_URL=
# API listen port.
API_PORT=3001
# PostgreSQL connection URL. Keep this value out of the web Worker.
DATABASE_URL=
# Better Auth signing secret. Keep this value out of source control.
BETTER_AUTH_SECRET=
# Optional production HTTPS webhook and bearer token for password-reset delivery,
# for example https://mail.example.com/password-reset.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_TOKEN=
# Log level used by server-side services.
LOG_LEVEL=
# Server-only OpenRouter credential. Never commit its value.
OPENROUTER_API_KEY=
# Optional Sentry project DSN.
SENTRY_DSN=
