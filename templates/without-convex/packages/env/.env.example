# Runtime environment: dev or prod.
APP_ENV=
# Public application origin.
APP_URL=
# Public API origin.
API_URL=
# API listen port.
API_PORT=3001
# PostgreSQL connection URL. Keep this value server-only.
DATABASE_URL=
# Better Auth signing secret. Keep this value server-only.
BETTER_AUTH_SECRET=
# Optional production HTTPS webhook and bearer token for password-reset delivery.
# PASSWORD_RESET_WEBHOOK_URL=https://mail.example.com/password-reset
# PASSWORD_RESET_WEBHOOK_TOKEN=
# Server log level.
LOG_LEVEL=info
# Server-only OpenRouter credential.
OPENROUTER_API_KEY=
# Optional Sentry project DSN.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
