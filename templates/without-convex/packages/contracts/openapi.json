  "components": {
    "schemas": {
      "HttpApiDecodeError": {
        "type": "object",
        "required": ["issues", "message", "_tag"],
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          },
          "message": {
            "type": "string"
          },
          "_tag": {
            "type": "string",
            "enum": ["HttpApiDecodeError"]
          }
        },
        "additionalProperties": false,
        "description": "The request did not match the expected schema"
      },
      "Issue": {
        "type": "object",
        "required": ["_tag", "path", "message"],
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Pointer",
              "Unexpected",
              "Missing",
              "Composite",
              "Refinement",
              "Transformation",
              "Type",
              "Forbidden"
            ],
            "description": "The tag identifying the type of parse issue"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyKey"
            },
            "description": "The path to the property where the issue occurred"
          },
          "message": {
            "type": "string",
            "description": "A descriptive message explaining the issue"
          }
        },
        "additionalProperties": false,
        "description": "Represents an error encountered while parsing a value to match the schema"
      },
      "PropertyKey": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "object",
            "required": ["_tag", "key"],
            "properties": {
              "_tag": {
                "type": "string",
                "enum": ["symbol"]
              },
              "key": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "an object to be decoded into a globally shared symbol"
          }
        ]
      },
      "NotFound": {
        "type": "object",
        "required": ["id", "_tag"],
        "properties": {
          "id": {
            "type": "string",
            "description": "a string at least 1 character(s) long",
            "title": "minLength(1)",
            "minLength": 1
          },
          "_tag": {
            "type": "string",
            "enum": ["NotFound"]
          }
        },
        "additionalProperties": false
      },
      "ConflictingTransition": {
        "type": "object",
        "required": ["command", "from", "id", "_tag"],
        "properties": {
          "command": {
            "type": "string",
            "enum": ["publish", "archive", "restore"]
          },
          "from": {
            "type": "string",
            "enum": ["draft", "published", "archived"]
          },
          "id": {
            "type": "string",
            "description": "a string at least 1 character(s) long",
            "title": "minLength(1)",
            "minLength": 1
          },
          "_tag": {
            "type": "string",
            "enum": ["ConflictingTransition"]
          }
        },
        "additionalProperties": false
      }
    },
