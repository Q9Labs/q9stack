{
  "name": "@__APP_SLUG__/database",
  "version": "0.1.0",
  "homepage": "https://github.com/Q9Labs/q9stack/tree/main/templates/without-convex/packages/database#readme",
  "bugs": "https://github.com/Q9Labs/q9stack/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/q9stack",
    "directory": "templates/without-convex/packages/database"
  },
  "files": [
    "dist",
    "migrations",
    "scripts",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev:prepare": "tsdown --no-clean",
    "dev:watch": "tsdown --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@__APP_SLUG__/core": "workspace:*",
    "@__APP_SLUG__/env": "workspace:*",
    "@effect/sql": "catalog:",
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@q9labsai/config-tsconfig": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
