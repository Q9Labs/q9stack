{
  "name": "@q9labsai/config-semgrep",
  "version": "0.3.0",
  "description": "Shareable Semgrep rule packs for q9labs TypeScript and JavaScript projects",
  "homepage": "https://github.com/Q9Labs/q9stack/tree/main/packages/config-semgrep#readme",
  "bugs": "https://github.com/Q9Labs/q9stack/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/q9stack",
    "directory": "packages/config-semgrep"
  },
  "files": [
    "dist",
    "rules",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./type-safety": "./rules/type-safety.yml",
    "./shape-heuristics": "./rules/shape-heuristics.yml",
    "./security": "./rules/security.yml"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@q9labsai/config-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
