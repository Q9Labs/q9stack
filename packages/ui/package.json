{
  "name": "@q9labsai/ui",
  "version": "0.3.0",
  "description": "The q9 design system: Tailwind 4 tokens, Base UI primitives, Hugeicons wrapper, app shell and theming",
  "homepage": "https://github.com/Q9Labs/q9stack/tree/main/packages/ui#readme",
  "bugs": "https://github.com/Q9Labs/q9stack/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/q9stack",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "default": "./dist/preview/index.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "default": "./dist/icon.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "default": "./dist/shell/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite --config preview/vite.config.ts",
    "preview:build": "vite build --config preview/vite.config.ts",
    "preview:shot": "node --experimental-strip-types preview/shoot.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "class-variance-authority": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@q9labsai/config-tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4.1"
  },
  "engines": {
    "node": ">=24"
  }
}
