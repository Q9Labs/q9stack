{
  "name": "@q9labsai/env",
  "version": "0.3.0",
  "description": "Typed, accumulated environment configuration for Node, Workers, and Vite",
  "homepage": "https://github.com/Q9Labs/q9stack/tree/main/packages/env#readme",
  "bugs": "https://github.com/Q9Labs/q9stack/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/q9stack",
    "directory": "packages/env"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/one-password": {
      "types": "./dist/adapters/one-password.d.ts",
      "import": "./dist/adapters/one-password.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@q9labsai/config-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
